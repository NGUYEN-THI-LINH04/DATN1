    {
      "start": 213.266,
      "end": 216.9,
      "hanzi": "没关系，你说吧。我很好奇。",
      "pinyin": "",
      "vi": ""
    },
    {
      "start": 216.933,
      "end": 223.033,
      "hanzi": "好。明天，星期六，我上午想在家看书。",
      "pinyin": "",
