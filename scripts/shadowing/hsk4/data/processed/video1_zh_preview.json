      "vi": ""
    },
    {
      "start": 774.966,
      "end": 776.766,
      "hanzi": "解释得非常清楚。",
      "pinyin": "",
      "vi": ""
    },
    {
      "start": 776.8,
      "end": 778.933,
      "hanzi": "最后一个词，“买单”。",
      "pinyin": "",
      "vi": ""
    },
    {
      "start": 778.966,
      "end": 781.966,
      "hanzi": "“买单”就是指吃完饭付钱。",
