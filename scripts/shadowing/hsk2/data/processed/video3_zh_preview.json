      "vi": ""
    },
    {
      "start": 882.766,
      "end": 885.566,
      "hanzi": "第三，是敢说，不怕错。",
      "pinyin": "",
      "vi": ""
    },
    {
      "start": 885.6,
      "end": 888.6,
